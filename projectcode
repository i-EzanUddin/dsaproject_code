class EventQueue{
    public:
        EventNode* head;
        EventNode* tail;
        int counte;

        EventQueue(){
            head= NULL;
            tail= NULL;
            counte=0;
        }

        void push(Event e1){
            EventNode* neweventnode=new EventNode(e1);
            if(empty()){
                head=tail=neweventnode;
            }
            else{
                tail->next=neweventnode;
                tail=neweventnode;
            }
        }

        void pop(){
            if(empty()){
                cout<<"error, empty list";
            }
            else{
                EventNode*temp=head;
                head=head->next;
                delete temp;
            }
        }

        EventNode front(){
            return head->eventdata;
        }

        bool empty(){
            if(head==NULL){
                return true;
            }
            else{
                return false;
            }
        }
