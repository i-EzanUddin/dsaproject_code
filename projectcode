class population{
    public:
        node* head;
        node* tail;
        int count;

        population(){
            count = 0;
            head=NULL;
            tail=NULL;
        }

        void insertatend(organism o1){
            if(count==100){
                cout<<"Maximum population reached"<<endl;
                return;
            }

            node* newnode = new node(o1);

            if(head==NULL){
                head=newnode;
                tail=newnode;
                count++;
                return;
            }

            tail->next=newnode;
            tail=newnode;
            count++;
        }

        void traverse(){
            node* temp = head;

            while(temp!=NULL){
                temp->data.display();
                cout<<endl;
                temp=temp->next;
            }
        }

        node* search(int id){
            node* temp = head;

            while(temp && temp->data.id!=id){
                temp=temp->next;
            }

            return temp;
        }

