class organism{
    public:
        int id;
        int x,y;
        int energy;
        int age;
        int speed;
        int vision;
        int lifespan;
        bool alive;

        organism(int x,int y,int energy,int age,int speed,int vision,int lifespan,bool alive){
            this->id=1000+create;
            this->x=x;
            this->y=y;
            this->energy=90;
            this->age=age;
            this->speed=1;
            this->vision=2;
            this->lifespan=lifespan;
            this->alive=alive;
            create++;
        }

        void display(){
            cout<<"ID= "<<this->id<<endl;
            cout<<"X coordinate = "<<this->x+1<<endl;
            cout<<"Y coordinate = "<<this->y+1<<endl;
            cout<<"Energy: "<<this->energy<<endl;
            cout<<"Age: "<<this->age<<endl;
            cout<<"Speed: "<<this->speed<<endl;
            cout<<"Vision: "<<this->vision<<endl;
            cout<<"Lifespan: "<<this->lifespan<<endl;
            if(this->alive){
                cout<<"This object is alive"<<endl;
            }
            else{
                cout<<"This object is dead"<<endl;
            }
        }

        void eat(){
            if(this->alive){
                if(this->energy+10>100){
                    this->energy=100;
                    //cout<<"Organisim reached its maximum capicity"<<endl;
                }
                else{
                    this->energy+=10;
                }
            }
        }

        void increaseage(){
            if(this->alive){
                this->age+=1;
            }
            checkdeath();
        }

        bool checkdeath(){
            if(this->age>=lifespan){
                this->alive=false;
                return true;
            }

            if(this->energy<=0){
                this->alive=false;
                return true;
            }
            
            return false;
        }
};


