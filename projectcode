class HistoryNode{
    public:
        History data;
        HistoryNode* next;

        HistoryNode(History h) : data(h){
            next=NULL;
        }
};

class HistoryStack{
    public:
        HistoryNode* top;
        int counth;

        HistoryStack(){
            top=NULL;
            counth=0;
        }

        void push(History h){
            HistoryNode* n=new HistoryNode(h);
            n->next=top;
            top=n;
            counth++;
        }

        void pop(){
            if(isEmpty()){
                cout<<"History is empty"<<endl;
                return;
            }
            HistoryNode* temp=top;
            top=top->next;
            delete temp;
            counth--;
        }

        void peek(){
            if(isEmpty()){
                cout<<"History is empty"<<endl;
                return;
            }
            top->data.display();
        }

        void display(){
            HistoryNode* temp=top;
            while(temp!=NULL){
                temp->data.display();
                cout<<endl;
                temp=temp->next;
            }
        }

        bool isEmpty(){
            return top==NULL;
        }
};

