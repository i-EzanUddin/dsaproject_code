	void updateorganism(){
	node* temp = p.head;
	
	while(temp){
		if(temp->data.alive){
			temp->data.age++;
			if(temp->data.energy-1 >= 0){	
			temp->data.energy--;
		}
			temp->data.checkdeath();
		}
		temp=temp->next;
	}
	
}

