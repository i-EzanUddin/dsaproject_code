           void moveOrgs(){
            node* temp = p.head;
            while(temp){
                if(!temp->data.alive){
                	w.remove_organism(temp->data.x, temp->data.y);
                    temp = temp->next;
                    continue;
                }

                int x = temp->data.x;
                int y = temp->data.y;
                if(isSafe(&x, &y, temp->data.speed, temp)){
                    w.remove_organism(temp->data.x, temp->data.y);
                    temp->data.x = x;
                    temp->data.y = y;
                    w.place_organism(x, y);
                }
                temp = temp->next;
            }
        }
	private:	
		//Default Direction -> random
		//Speed -> Within range from speed to 1
		
	bool isSafe(int *x, int *y, int factor, node* temp){
            if(factor < 1){
                return false;
            }
            
			int dx[4] = {-1,0,1,0}; //col
			int dy[4] = {0,1,0,-1}; //row
			int randomIdx = rand() % 4;
			
			for(int i = 0; i < 4; i++){
				if(temp->data.energy < 2 * factor){
					return false;
				} 
				int k = (randomIdx + i) % 4;
				int selectDx = dx[k] * factor + *x;
				int selectDy = dy[k] * factor + *y;
				
				bool clear = false;
				if(k == 0){
					clear = up(selectDx, selectDy,temp);
				} 
				else if(k == 1){
					clear = right(selectDx, selectDy,temp);
				}
				else if(k == 2){
					clear = down(selectDx, selectDy,temp);
				}
				else{
					clear = left(selectDx, selectDy,temp);	
				}
				if(clear && isValidIndices(selectDx, selectDy, temp)){
					*x = selectDx;
					*y = selectDy;
					temp->data.energy -= 2 * factor;
					return true;
				}
			}
            if(isSafe(x, y, factor - 1, temp)){
                return true;
            }
            else{
                return false;
            }
        }
        
		bool isValidIndices(int x, int y, node* temp){
            if(w.isempty(x, y)){
                return true;
            }
            else if(w.isFood(x, y)){
//                feedOrg(x, y, temp);
                feedorganism();
                return true;
            }
            else{
                return false;
            }
        }

			bool right(int x, int y, node* temp){
            if(!w.isvalid(x, y)){
                return false;
            }
            for(int j = temp->data.y + 1; j <= y; j++){
                if(w.arr[x][j] == '#' || w.arr[x][j] == 'O'){
                    return false;
                }
            }
            return true;
        }

        bool left(int x, int y, node* temp){
            if(!w.isvalid(x, y)){
                return false;
            }
            for(int j = temp->data.y - 1; j >= y; j--){
                if(w.arr[x][j] == '#' || w.arr[x][j] == 'O'){
                    return false;
                }
            }
            return true;
        }

        bool down(int x, int y, node* temp){
            if(!w.isvalid(x, y)){
                return false;
            }
            for(int i = temp->data.x + 1; i <= x; i++){
                if(w.arr[i][y] == '#' || w.arr[i][y] == 'O'){
                    return false;
                }
            }
            return true;
        }

        bool up(int x, int y, node* temp){
            if(!w.isvalid(x, y)){
                return false;
            }
            for(int i = temp->data.x - 1; i >= x; i--){
                if(w.arr[i][y] == '#' || w.arr[i][y] == 'O'){
                    return false;
                }
            }
            return true;
        }
