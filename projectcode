int main(){
    srand(time(0));

    simulation s;
    s.initialize();

    // Display initial grid
    s.w.display();

    while(true){

        // Check keyboard input
        if(_kbhit()){
            char key = _getch();

            // Pause simulation
            if(key == ' '){

                system("cls");

                cout << "========== SIMULATION PAUSED ==========" << endl;
                cout << "Press SPACE to resume or ESC to exit." << endl;
                cout << endl;

                // Display frozen grid
                s.w.display();

                cout << endl;
                cout << "========== ORGANISM DETAILS ==========" << endl;
                cout << endl;

                // Display all organisms only once
                s.p.traverse();

                cout << endl;
                cout << "======================================" << endl;
                cout << "Press SPACE to resume simulation." << endl;

                // Wait until user presses Space or Escape
                while(true){

                    char pauseKey = _getch();

                    if(pauseKey == ' '){
                        break;
                    }

                    if(pauseKey == 27){
                        return 0;
                    }
                }

                system("cls");
            }

            // Exit simulation
            else if(key == 27){
                break;
            }
        }

        // Continue organism movement
        s.moveOrgs();

        system("cls");
        s.w.display();

        Sleep(250);
    }

    return 0;
